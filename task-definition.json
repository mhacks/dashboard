{
  "containerDefinitions": [
    {
      "name": "dashboard",
      "image": "AWS_ACCOUNT_ID.dkr.ecr.us-east-2.amazonaws.com/dashboard:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "name": "dashboard-3000-tcp"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "RESUMES_BUCKET",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/RESUMES_BUCKET"
        },
        {
          "name": "RESUMES_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/RESUMES_ACCESS_KEY_ID"
        },
        {
          "name": "RESUMES_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/RESUMES_SECRET_ACCESS_KEY"
        },
        {
          "name": "AWS_SES_SMTP_USER",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/AWS_SES_SMTP_USER"
        },
        {
          "name": "AWS_SES_SMTP_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/AWS_SES_SMTP_PASSWORD"
        },
        {
          "name": "AWS_SES_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/AWS_SES_SECRET_ACCESS_KEY"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/DATABASE_URL"
        },
        {
          "name": "SUPABASE_DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/SUPABASE_DB_PASSWORD"
        },
        {
          "name": "SUPABASE_SERVICE_ROLE_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/SUPABASE_SERVICE_ROLE_KEY"
        },
        {
          "name": "LOGIN_TURNSTILE_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/LOGIN_TURNSTILE_SECRET_KEY"
        },
        {
          "name": "DISCORD_LINK_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/DISCORD_LINK_SECRET"
        },
        {
          "name": "APPLE_WALLET_PASS_TYPE_ID",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/APPLE_WALLET_PASS_TYPE_ID"
        },
        {
          "name": "APPLE_WALLET_TEAM_ID",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/APPLE_WALLET_TEAM_ID"
        },
        {
          "name": "APPLE_WALLET_SIGNER_CERT",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/APPLE_WALLET_SIGNER_CERT"
        },
        {
          "name": "APPLE_WALLET_SIGNER_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/APPLE_WALLET_SIGNER_KEY"
        },
        {
          "name": "APPLE_WALLET_SIGNER_KEY_PASSPHRASE",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/APPLE_WALLET_SIGNER_KEY_PASSPHRASE"
        },
        {
          "name": "APPLE_WALLET_WWDR_CERT",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/APPLE_WALLET_WWDR_CERT"
        },
        {
          "name": "GOOGLE_WALLET_ISSUER_ID",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/GOOGLE_WALLET_ISSUER_ID"
        },
        {
          "name": "GOOGLE_WALLET_SERVICE_ACCOUNT_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/GOOGLE_WALLET_SERVICE_ACCOUNT_KEY"
        },
        {
          "name": "WALLET_LINK_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/WALLET_LINK_SECRET"
        },
        {
          "name": "MDREDD_API_URL",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/MDREDD_API_URL"
        },
        {
          "name": "MDREDD_API_TOKEN",
          "valueFrom": "arn:aws:ssm:us-east-2:AWS_ACCOUNT_ID:parameter/mhacks-secrets/MDREDD_API_TOKEN"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mhacks-dashboard",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "healthCheck": {
        "command": [
          "CMD",
          "node",
          "-e",
          "\"if(!(await fetch('http://localhost:3000/health')).ok) process.exit(1)\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "systemControls": []
    }
  ],
  "family": "mhacks-dashboard",
  "executionRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/mhacks-ecs-exec",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "1024"
}
